<Window x:Class="AiCodeReviewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Code Reviewer" Height="850" Width="1220" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172033" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="BorderBrush" Value="#C8D0DE" /><Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="100" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DCE2EC" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,14,14" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="AI-ASSISTED ENGINEERING" Foreground="#3157D5" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="Review code with context" FontSize="34" FontWeight="Bold" />
            <TextBlock Text="Choose a workflow, inspect structured findings, and keep publishing under human control." Foreground="#5E6B82" FontSize="15" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Review setup" FontSize="21" FontWeight="Bold" Margin="0,0,0,12" />
                            <TextBlock Text="Review mode" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Padding="7" Margin="0,4,0,12" />

                            <StackPanel Visibility="{Binding UsesPath, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PathLabel}" FontWeight="SemiBold" />
                                <DockPanel LastChildFill="True">
                                    <Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseCommand}" MinWidth="82" Margin="8,4,0,10" />
                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source path" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding UsesRemoteUrl, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Remote HTTPS Git URL" FontWeight="SemiBold" />
                                <TextBox Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Remote Git URL" />
                                <TextBlock Text="Do not include credentials in the URL." Foreground="#5E6B82" Margin="0,0,0,8" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding UsesPullRequest, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="GitHub owner" FontWeight="SemiBold" /><TextBox Text="{Binding GitHubOwner}" />
                                <TextBlock Text="Repository" FontWeight="SemiBold" /><TextBox Text="{Binding GitHubRepository}" />
                                <TextBlock Text="Pull-request number" FontWeight="SemiBold" /><TextBox Text="{Binding PullRequestNumber}" />
                                <TextBlock Text="Always reviewed as a dry run first." Foreground="#5E6B82" Margin="0,0,0,8" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding UsesRepositoryLimits, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Maximum files" FontWeight="SemiBold" /><TextBox Text="{Binding MaximumFiles}" />
                                <TextBlock Text="Maximum characters" FontWeight="SemiBold" /><TextBox Text="{Binding MaximumCharacters}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Start review" Command="{Binding StartCommand}" Background="#3157D5" Foreground="White" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Configuration" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="{Binding Configuration.OpenAiModel, StringFormat=Model: {0}}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Configuration.OpenAiApiKeyConfigured, StringFormat=OpenAI key configured: {0}}" />
                            <TextBlock Text="{Binding Configuration.GitHubTokenConfigured, StringFormat=GitHub publishing available: {0}}" />
                            <TextBlock Text="Credentials come from environment variables and are never shown or stored here." TextWrapping="Wrap" Foreground="#5E6B82" Margin="0,8,0,0" />
                            <TextBlock Text="Preferences" FontSize="17" FontWeight="Bold" Margin="0,16,0,4" />
                            <TextBlock Text="Default export" /><ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding PreferredExportFormat}" Margin="0,4,0,8" />
                            <TextBlock Text="Theme" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Margin="0,4,0,8" />
                            <Button Content="Save preferences" Command="{Binding SavePreferencesCommand}" HorizontalAlignment="Left" />
                            <TextBlock Text="Recent reviews" FontSize="17" FontWeight="Bold" Margin="0,16,0,4" />
                            <ItemsControl ItemsSource="{Binding RecentReviews}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Mode}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Results" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="{Binding Report.Subject}" Foreground="#5E6B82" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
                            <Button Content="Export Markdown" Command="{Binding ExportMarkdownCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12">
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="9" />
                        <TextBlock Text="{Binding Status}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding Error.Message}" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search findings" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Severities}" SelectedItem="{Binding SeverityFilter}" Margin="0,0,8,0" AutomationProperties.Name="Severity filter" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding FindingSorts}" SelectedItem="{Binding FindingSort}" AutomationProperties.Name="Finding sort" />
                    </Grid>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredFindings}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="File / location" Binding="{Binding File}" Width="180" />
                            <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*" />
                            <DataGridTextColumn Header="Suggested improvement" Binding="{Binding SuggestedImprovement}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="4" Background="#FFF5F3" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                            Visibility="{Binding HasPublicationDraft, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Publish GitHub comments" FontWeight="Bold" />
                            <TextBlock Text="Inspect every draft. Publishing needs fresh confirmation." />
                            <CheckBox Content="I reviewed and approve publishing these comments now." IsChecked="{Binding PublishConfirmed}" Margin="0,8" />
                            <Button Content="Publish approved comments" Command="{Binding PublishCommand}" HorizontalAlignment="Left" Background="#B42318" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Human verification remains required for every AI-generated finding." Foreground="#5E6B82" HorizontalAlignment="Right" />
    </Grid>
</Window>
